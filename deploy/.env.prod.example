# ============================================================================
# MIE 生产环境变量 — 复制为 .env.prod 并填写
#   cp deploy/.env.prod.example .env.prod
# 注意：.env.prod 已被 .gitignore 排除（.env.* 规则），不会提交到 git
# ============================================================================

# --- 数据库（compose 会覆盖为容器内服务名连接，此处仅需密码）---
POSTGRES_PASSWORD=mie

# --- LLM（OpenAI 兼容：DeepSeek / Kimi / OpenAI ...）---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat

# --- 前端 API 地址（build-time 注入；nginx 会把 /api 重写到后端）---
# 无域名阶段：http://服务器IP/api（如 http://47.98.123.45/api）
# 绑定域名后：https://你的域名/api（改后需 --build 重建前端）
NEXT_PUBLIC_API_URL=http://your-server-ip/api

# --- 可选：知乎 Cookie（z_c0/d_c0/__zse_ck，约 6 天过期需刷新）---
# ZHIHU_COOKIES=

# --- 可选：HuggingFace 镜像（服务器无法直连 huggingface.co 时启用）---
# HF_ENDPOINT=https://hf-mirror.com